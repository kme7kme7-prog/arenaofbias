{
  "name": "arenaofbias",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app src lib server scripts vite.config.ts",
    "format": "oxfmt",
    "validate:arena": "node scripts/validate-arena.mjs",
    "validate:scroll": "node scripts/validate-scroll-tour.mjs",
    "validate:comments": "node scripts/validate-comments.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "better-sqlite3": ">=11.9.0 <13.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "^4.21.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^9.1.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
